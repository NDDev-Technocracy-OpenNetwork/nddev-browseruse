{
  "openapi": "3.1.0",
  "info": {
    "title": "nddev-browseruse local contracts",
    "description": "",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "2"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ActivitySettings": {
        "type": "object",
        "required": [
          "batchRecords",
          "batchBytes",
          "queueRecords",
          "queueBytes",
          "sendDelayMs",
          "bodyBytes",
          "networkTasks"
        ],
        "properties": {
          "batchBytes": {
            "type": "integer",
            "minimum": 0
          },
          "batchRecords": {
            "type": "integer",
            "description": "Records and serialized bytes in one native activity command, per executor.",
            "minimum": 0
          },
          "bodyBytes": {
            "type": "integer",
            "description": "Maximum safely sized, uncompressed HTTP body read for a journal record.",
            "minimum": 0
          },
          "networkTasks": {
            "type": "integer",
            "description": "Concurrent metadata/body lookups; a slot stays held until the underlying call settles.",
            "minimum": 0
          },
          "queueBytes": {
            "type": "integer",
            "minimum": 0
          },
          "queueRecords": {
            "type": "integer",
            "description": "Total queued records/bytes, including a batch awaiting delivery; one sender at a time.",
            "minimum": 0
          },
          "sendDelayMs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "BadgeColors": {
        "type": "object",
        "description": "Colors projected from the public DS for Chrome APIs that cannot accept CSS tokens.",
        "required": [
          "neutral",
          "warning",
          "error",
          "accent"
        ],
        "properties": {
          "accent": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "neutral": {
            "type": "string"
          },
          "warning": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "BrowserStatus": {
        "type": "object",
        "description": "Popup projection; website, group and journal values are local operation results, never logs.",
        "required": [
          "enabled",
          "observation",
          "connected",
          "consentRequired",
          "hostUpdateRequired",
          "tabs",
          "version",
          "privateSites",
          "hasTab"
        ],
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "consentRequired": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "hasTab": {
            "type": "boolean"
          },
          "host": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Build"
              },
              {
                "type": "null"
              }
            ]
          },
          "hostContract": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "hostUpdateRequired": {
            "type": "boolean"
          },
          "observation": {
            "$ref": "#/components/schemas/Observation"
          },
          "privateSites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "site": {
            "type": [
              "string",
              "null"
            ]
          },
          "tabs": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Build": {
        "type": "object",
        "required": [
          "version",
          "commit"
        ],
        "properties": {
          "commit": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Capabilities": {
        "type": "object",
        "description": "Discovery is a separate operation so an older client receives the unchanged Status shape.",
        "required": [
          "protocol",
          "host",
          "browser_ready",
          "owned_sessions",
          "cancellation",
          "drained_close",
          "group_control",
          "terminal_groups",
          "idle_timeout_ms",
          "max_sessions",
          "max_tabs",
          "max_execution_ms"
        ],
        "properties": {
          "browser_ready": {
            "type": "boolean"
          },
          "cancellation": {
            "type": "boolean"
          },
          "drained_close": {
            "type": "boolean"
          },
          "group_control": {
            "type": "boolean"
          },
          "host": {
            "$ref": "#/components/schemas/Build"
          },
          "idle_timeout_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "max_execution_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "max_sessions": {
            "type": "integer",
            "minimum": 0
          },
          "max_tabs": {
            "type": "integer",
            "minimum": 0
          },
          "owned_sessions": {
            "type": "boolean"
          },
          "protocol": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "terminal_groups": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CaptureFailure": {
        "type": "string",
        "enum": [
          "policy_changed",
          "document_changed",
          "private_page",
          "capacity",
          "invalid_request",
          "unavailable",
          "stopped",
          "frame_limit",
          "target_closed"
        ]
      },
      "CaptureReply": {
        "type": "object",
        "required": [
          "kept",
          "frames",
          "bytes"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "directory": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CaptureFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "frames": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "kept": {
            "type": "boolean"
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "CaptureRequest": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "epoch",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "begin"
                ]
              },
              "directory": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "epoch": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "page",
              "target",
              "epoch",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "page"
                ]
              },
              "epoch": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "page": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "target": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "scope",
              "page",
              "at",
              "data",
              "epoch",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "frame"
                ]
              },
              "at": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "data": {
                "type": "string"
              },
              "epoch": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "page": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "scope": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "stop"
                ]
              },
              "id": {
                "type": "string"
              }
            }
          }
        ],
        "description": "Private local operation data. Never implement Debug or send these fields to diagnostics."
      },
      "ExecutionSettings": {
        "type": "object",
        "description": "Operational deadline context, independent of retained observation data.",
        "required": [
          "pendingSteps",
          "recentSteps",
          "snapshotTimeoutMs"
        ],
        "properties": {
          "pendingSteps": {
            "type": "integer",
            "minimum": 0
          },
          "recentSteps": {
            "type": "integer",
            "minimum": 0
          },
          "snapshotTimeoutMs": {
            "type": "integer",
            "format": "int64",
            "description": "Optional live tab metadata must leave room for the client's execution reply.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "ExecutorSettings": {
        "type": "object",
        "description": "Public to the local thin executor. Fixed for one host/executor lifetime; policy stays live.",
        "required": [
          "execution",
          "activity",
          "recorder"
        ],
        "properties": {
          "activity": {
            "$ref": "#/components/schemas/ActivitySettings"
          },
          "execution": {
            "$ref": "#/components/schemas/ExecutionSettings"
          },
          "recorder": {
            "$ref": "#/components/schemas/RecorderSettings"
          }
        },
        "additionalProperties": false
      },
      "FrontendConfig": {
        "type": "object",
        "description": "Public, non-secret settings shipped with this extension. Changes take effect at worker restart.",
        "required": [
          "lifecycle",
          "minimumHost",
          "consentRevision",
          "initialObservation",
          "privateSitesLimit",
          "awakeIdleMs",
          "setupTimeoutMs",
          "ownerReplyMs",
          "ownerRequestsLimit",
          "refreshMs",
          "batchEvents",
          "batchBytes",
          "partsBytes",
          "guideUrl",
          "privacyUrl",
          "installUrl"
        ],
        "properties": {
          "awakeIdleMs": {
            "type": "integer",
            "format": "int32",
            "description": "Milliseconds without agent work before the tiny keep-awake capture ends, per tab.",
            "minimum": 0
          },
          "batchBytes": {
            "type": "integer",
            "format": "int32",
            "description": "Maximum estimated bytes in one native-message batch, per extension connection.",
            "minimum": 0
          },
          "batchEvents": {
            "type": "integer",
            "format": "int32",
            "description": "Maximum events in one native-message batch, per extension connection.",
            "minimum": 0
          },
          "consentRevision": {
            "type": "integer",
            "format": "int32",
            "description": "Monotonic revision of the prominent disclosure accepted in this browser profile.",
            "minimum": 0
          },
          "guideUrl": {
            "type": "string"
          },
          "initialObservation": {
            "$ref": "#/components/schemas/Observation",
            "description": "Desired profile for a new installation; effective collection remains Off until consent."
          },
          "installUrl": {
            "type": "string"
          },
          "lifecycle": {
            "$ref": "#/components/schemas/LifecycleSettings"
          },
          "minimumHost": {
            "type": "string",
            "description": "Minimum native host version that enforces observation revocation."
          },
          "ownerReplyMs": {
            "type": "integer",
            "format": "int32",
            "description": "Milliseconds for a popup recorder or journal response, per request.",
            "minimum": 0
          },
          "ownerRequestsLimit": {
            "type": "integer",
            "format": "int32",
            "description": "Shared maximum in-flight recorder and journal requests, per browser connection.",
            "minimum": 0
          },
          "partsBytes": {
            "type": "integer",
            "format": "int32",
            "description": "Maximum joined message bytes, per extension connection.",
            "minimum": 0
          },
          "privacyUrl": {
            "type": "string"
          },
          "privateSitesLimit": {
            "type": "integer",
            "format": "int32",
            "description": "Maximum number of private hostnames in this browser profile.",
            "minimum": 0
          },
          "refreshMs": {
            "type": "integer",
            "format": "int32",
            "description": "Milliseconds between popup activity refreshes; no refresh before consent.",
            "minimum": 0
          },
          "setupTimeoutMs": {
            "type": "integer",
            "format": "int32",
            "description": "Milliseconds for one browser setup command, per command.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "GroupDashboard": {
        "type": "object",
        "required": [
          "connected",
          "observation"
        ],
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GroupFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "identity": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GroupIdentity"
              },
              {
                "type": "null"
              }
            ]
          },
          "observation": {
            "$ref": "#/components/schemas/Observation"
          },
          "status": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GroupStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "GroupFailure": {
        "type": "string",
        "enum": [
          "unavailable",
          "request_failed",
          "ownership_conflict"
        ]
      },
      "GroupIdentity": {
        "type": "object",
        "description": "Browser-local recovery identity, never a native session capability or a grant to execute code.",
        "required": [
          "id",
          "project",
          "createdAtMs"
        ],
        "properties": {
          "createdAtMs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "project": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "GroupMetrics": {
        "type": "object",
        "description": "Bounded aggregate counters. No operation arguments or page-content fields are retained here.",
        "required": [
          "completed",
          "failed",
          "totalMs"
        ],
        "properties": {
          "completed": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "lastMs": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "totalMs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "GroupPhase": {
        "type": "string",
        "enum": [
          "starting",
          "ready",
          "running",
          "recording",
          "closing"
        ]
      },
      "GroupStatus": {
        "type": "object",
        "description": "Owner-only operational projection. It contains no session capability or execution code.",
        "required": [
          "project",
          "phase",
          "uptimeMs",
          "idleMs",
          "idleTimeoutMs",
          "siteTabs"
        ],
        "properties": {
          "idleMs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "idleTimeoutMs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "metrics": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GroupMetrics",
                "description": "Absent while observation is Off. Revocation discards the aggregate history."
              },
              {
                "type": "null"
              }
            ]
          },
          "phase": {
            "$ref": "#/components/schemas/GroupPhase"
          },
          "project": {
            "type": "string"
          },
          "siteTabs": {
            "type": "integer",
            "minimum": 0
          },
          "uptimeMs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "LifecycleSettings": {
        "type": "object",
        "description": "Per-host and per-browser cleanup limits. New host/worker instances read them once.",
        "required": [
          "idleTimeoutMs",
          "sweepIntervalMs",
          "orphanGraceMs",
          "groupsLimit"
        ],
        "properties": {
          "groupsLimit": {
            "type": "integer",
            "description": "Durable group records in one browser profile, including groups awaiting cleanup.",
            "minimum": 0
          },
          "idleTimeoutMs": {
            "type": "integer",
            "format": "int64",
            "description": "Inactivity deadline per session. Executions and explicit recording suspend expiry.",
            "minimum": 0
          },
          "orphanGraceMs": {
            "type": "integer",
            "format": "int64",
            "description": "Recovery grace for a durable control tab whose previous host no longer owns it.",
            "minimum": 0
          },
          "sweepIntervalMs": {
            "type": "integer",
            "format": "int64",
            "description": "Maximum interval between the host's cleanup passes.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "Observation": {
        "type": "string",
        "enum": [
          "full",
          "standard",
          "off"
        ]
      },
      "OwnerRecent": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "lines": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "OwnerRecording": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "events": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "recording": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "RecorderSettings": {
        "type": "object",
        "required": [
          "frameIntervalMs",
          "frameBytes",
          "maxBytes",
          "maxMs",
          "queuedFrames",
          "queuedBytes",
          "queuedEvents",
          "secretCache",
          "secretTimeoutMs",
          "jpegQuality",
          "maxEdge",
          "frameTargets"
        ],
        "properties": {
          "frameBytes": {
            "type": "integer",
            "minimum": 0
          },
          "frameIntervalMs": {
            "type": "integer",
            "format": "int64",
            "description": "Milliseconds between retained frames, per page.",
            "minimum": 0
          },
          "frameTargets": {
            "type": "integer",
            "minimum": 0
          },
          "jpegQuality": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "maxBytes": {
            "type": "integer",
            "format": "int64",
            "description": "One recording's total retained bytes and duration in milliseconds.",
            "minimum": 0
          },
          "maxEdge": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "maxMs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "queuedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "queuedEvents": {
            "type": "integer",
            "minimum": 0
          },
          "queuedFrames": {
            "type": "integer",
            "minimum": 0
          },
          "secretCache": {
            "type": "integer",
            "minimum": 0
          },
          "secretTimeoutMs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  }
}
